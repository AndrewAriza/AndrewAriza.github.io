---
// self-hosted so the render-blocking Google Fonts round-trip disappears; wght-only, no italics
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { CONTENT, LOCALES, type Lang } from "../data/content";

interface Props {
  lang: Lang;
  /** 404 and friends: keep them out of the index but let crawlers follow links out */
  noindex?: boolean;
  title?: string;
}

const { lang: pageLang, noindex = false, title } = Astro.props;
const t = CONTENT[pageLang];
const site = Astro.site ?? new URL("https://andrewariza.github.io/");
const locale = LOCALES.find((l) => l.lang === pageLang)!;
const canonical = new URL(locale.path, site);
const ogImage = new URL("og.png", site);
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }
    {!noindex && <link rel="canonical" href={canonical.href} />}

    {
      !noindex &&
        LOCALES.map((l) => (
          <link rel="alternate" hreflang={l.lang} href={new URL(l.path, site).href} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrés Ariza" />
    <meta property="og:locale" content={locale.ogLocale} />
    {
      LOCALES.filter((l) => l.lang !== pageLang).map((l) => (
        <meta property="og:locale:alternate" content={l.ogLocale} />
      ))
    }
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@AndrewAriza" />
    <meta name="theme-color" content="#0b0b0c" />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body>
    <div id="loader" class="loader">
      <span>LOADING</span>
      <span class="loader__bar"></span>
      <span>ANDRES ARIZA</span>
    </div>

    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>

    <slot />

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
